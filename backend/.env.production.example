# Supabase production connection settings.
# In Supabase Dashboard > Connect, choose Session pooler and copy the URI
# (port 5432). Replace the placeholders below with that connection's values.
# URL-encode reserved characters in the database password. Keep sslmode=require.
# For Render, add these values under the service's Environment tab; do not upload
# this file or commit real credentials.

ENVIRONMENT=production

# Generate a private key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_private_random_64_character_hex_secret

# Supabase project Session pooler (IPv4) URI. Replace only the password with
# your URL-encoded database password. Keep port 5432 and sslmode=require.
DATABASE_URL=postgresql://postgres.bxururrrjialvfkomayt:URL_ENCODED_DATABASE_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# JSON list of deployed frontend origins. Keep this HTTPS origin exact; do not
# add localhost to the production list.
BACKEND_CORS_ORIGINS=["https://jari-jet.vercel.app"]
