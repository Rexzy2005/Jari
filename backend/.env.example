# Local backend settings. For a Supabase database, replace DATABASE_URL with
# the Session pooler URI from Supabase Dashboard > Connect (port 5432).
# URL-encode special characters in its password and keep sslmode=require.
# Format: postgresql://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://jari_user:jari_dev_password@localhost:5432/jari_db
SECRET_KEY=change_this_to_a_secure_secret_key_in_production_min_32_chars
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

